{
  "name": "corrosion-atlas-curator",
  "main": "src/curator-worker.js",
  "compatibility_date": "2026-05-10",

  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./curator-web",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "routes": [
    {
      "pattern": "curator.corrosionatlas.org",
      "custom_domain": true
    }
  ]
}